{
  "name": "launch-agent",
  "private": true,
  "type": "module",
  "description": "Submit your product to startup and SaaS directories with a guarded AI agent: approve a batch once, and it fills the forms, free routes only.",
  "license": "MIT",
  "author": "APSquared",
  "homepage": "https://github.com/apsquared/launch-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apsquared/launch-agent.git"
  },
  "bugs": {
    "url": "https://github.com/apsquared/launch-agent/issues"
  },
  "keywords": [
    "launch",
    "directories",
    "startups",
    "saas",
    "product-hunt",
    "ai-agent",
    "claude-code",
    "mcp",
    "playwright"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx src/cli/setup.ts",
    "copy:sources": "tsx src/cli/copy-sources.ts",
    "copy:apply": "tsx src/cli/copy-apply.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx src/guards.test.ts && tsx src/badge-output.test.ts && tsx src/listing-check.test.ts && tsx src/draft.test.ts && tsx src/repo.test.ts && tsx src/skills.test.ts && tsx src/agents.test.ts && tsx src/privacy.test.ts && tsx src/examples.test.ts && tsx src/schemas.test.ts",
    "chrome:login": "tsx src/cli/login.ts",
    "batch:propose": "tsx src/cli/propose.ts",
    "batch:show": "tsx src/cli/show.ts",
    "batch:approve": "tsx src/cli/approve.ts",
    "run": "tsx src/cli/run.ts",
    "verify": "tsx src/cli/verify.ts",
    "badges:sync": "tsx src/cli/badges.ts",
    "digest": "tsx src/cli/digest.ts",
    "mark": "tsx src/cli/mark.ts",
    "pass": "tsx src/cli/pass.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
