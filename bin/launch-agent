#!/usr/bin/env bash
# launch-agent's command line: `launch-agent <command> [args]` runs one of its npm scripts
# (doctor, init, copy:sources, batch:propose, pass, watch:start, ...). With the Claude Code plugin
# this is on the Bash tool's PATH; in a checkout, `npm run <command> -- <args>` does the same.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
ROOT="$(cd "$(dirname "$self")/.." && pwd)"

# Your data never lives in the tool's folder when it was installed as a plugin (that folder is
# replaced on every update): use ~/.launch-agent/workspace unless you chose a workspace, or this is
# a checkout that already has its own gitignored workspace/.
if [ -z "${LAUNCH_AGENT_WORKSPACE:-}" ] && [ ! -d "$ROOT/workspace" ]; then
  export LAUNCH_AGENT_WORKSPACE="$HOME/.launch-agent/workspace"
fi

if [ ! -x "$ROOT/node_modules/.bin/tsx" ]; then
  echo "launch-agent: installing its dependencies (first run after install or update) ..." >&2
  npm --prefix "$ROOT" ci --omit=dev --no-audit --no-fund --loglevel=error >&2
fi

if [ $# -eq 0 ] || [ "$1" = "help" ] || [ "$1" = "--help" ]; then
  echo "usage: launch-agent <command> [args]"
  echo
  echo "commands:"
  node -e 'for (const k of Object.keys(require(process.argv[1]).scripts)) if (!["test", "typecheck", "mcp"].includes(k)) console.log("  " + k)' "$ROOT/package.json"
  exit 0
fi

export LAUNCH_AGENT_CLI=1
command="$1"
shift
exec npm --prefix "$ROOT" run --silent "$command" -- "$@"
